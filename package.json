{
  "name": "guildpass-core",
  "version": "2.0.0",
  "private": true,
  "description": "Core infrastructure for GuildPass",
  "packageManager": "pnpm@10",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @guildpass/api dev",
    "db:generate": "pnpm --filter @guildpass/api prisma:generate",
    "db:migrate": "pnpm --filter @guildpass/api prisma:migrate",
    "db:studio": "pnpm --filter @guildpass/api prisma:studio"
  }
}
